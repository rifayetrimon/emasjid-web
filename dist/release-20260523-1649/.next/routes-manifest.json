{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/maintenance-preview/[id]",
      "regex": "^/maintenance\\-preview/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/maintenance\\-preview/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/news/[id]",
      "regex": "^/news/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/news/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/static/[slug]",
      "regex": "^/static/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/static/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[...slug]",
      "regex": "^/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPslug>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/demo2",
      "regex": "^/demo2(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/demo2(?:/)?$"
    },
    {
      "page": "/demo3",
      "regex": "^/demo3(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/demo3(?:/)?$"
    },
    {
      "page": "/demo4",
      "regex": "^/demo4(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/demo4(?:/)?$"
    },
    {
      "page": "/demo5",
      "regex": "^/demo5(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/demo5(?:/)?$"
    },
    {
      "page": "/demo6",
      "regex": "^/demo6(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/demo6(?:/)?$"
    },
    {
      "page": "/donation",
      "regex": "^/donation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/donation(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/maintenance-preview",
      "regex": "^/maintenance\\-preview(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/maintenance\\-preview(?:/)?$"
    },
    {
      "page": "/news",
      "regex": "^/news(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/news(?:/)?$"
    },
    {
      "page": "/shop",
      "regex": "^/shop(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop(?:/)?$"
    },
    {
      "page": "/shop/cart",
      "regex": "^/shop/cart(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop/cart(?:/)?$"
    },
    {
      "page": "/shop/checkout",
      "regex": "^/shop/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop/checkout(?:/)?$"
    },
    {
      "page": "/shop/order-received",
      "regex": "^/shop/order\\-received(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop/order\\-received(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}