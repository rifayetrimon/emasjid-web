# Copy this file to `.env.production` on the server and adjust values.
# `.env*` is gitignored except for this example file.

# Port Next.js will listen on. The reverse proxy (nginx/Caddy) forwards to this.
PORT=4000

# Bind address. 0.0.0.0 makes the server reachable from outside the box;
# 127.0.0.1 restricts it to localhost (use when a proxy on the same box
# is the only thing that should reach Next.js directly).
HOSTNAME=0.0.0.0

# Standard Node flag. Next.js sets this automatically for `next start`,
# but listing it here makes the runtime mode explicit.
NODE_ENV=production
