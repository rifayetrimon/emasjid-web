#!/bin/sh
# Runs inside the nginx container at startup, BEFORE the image's built-in
# envsubst step (20-envsubst-on-templates.sh). The nginx entrypoint *sources*
# files ending in .envsh, so the API_PROXY_TARGET we export here is visible to
# the template substitution that produces /etc/nginx/conf.d/default.conf.
#
# It derives the upstream from the SAME config.json the browser reads, so
# editing NEXT_PUBLIC_API_URL (aws01 vs devapi…) drives both the page and the
# proxy. Note: nginx reads this once at container start, so changing the API
# host requires a container restart (unlike the browser-side config values,
# which update on refresh).
CONFIG_FILE=/usr/share/nginx/html/config.json
DEFAULT_TARGET="https://aws01.awfatech.com"

# An explicit env override always wins.
target="${API_PROXY_TARGET:-}"

if [ -z "$target" ] && [ -f "$CONFIG_FILE" ]; then
    # Pull the NEXT_PUBLIC_API_URL string value. Tolerates surrounding
    # whitespace; ignores anything after the quoted value (e.g. // comments).
    target=$(sed -n 's/.*"NEXT_PUBLIC_API_URL"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG_FILE" | head -n1)
fi

[ -z "$target" ] && target="$DEFAULT_TARGET"

# Strip any trailing slash so the template controls the join in proxy_pass.
target=$(printf '%s' "$target" | sed 's:/*$::')

export API_PROXY_TARGET="$target"
echo "[entrypoint] /api/ -> ${API_PROXY_TARGET}/api/ (from ${CONFIG_FILE})"
